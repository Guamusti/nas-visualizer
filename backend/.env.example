# NAS connection
NAS_HOST=192.168.1.100
NAS_PORT=5005
NAS_USE_HTTPS=false
NAS_USERNAME=admin
NAS_PASSWORD=your_password

# Path inside the NAS to index (e.g. /Photos or /homes/admin/Photos)
NAS_PHOTOS_PATH=/Photos

# Local cache for thumbnails (absolute path or relative to backend/)
THUMBNAIL_CACHE_DIR=./thumbnail_cache

# SQLite database path
DATABASE_URL=sqlite+aiosqlite:///./nas_photos.db

# API server
HOST=0.0.0.0
PORT=8000
